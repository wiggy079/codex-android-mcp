{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rootDir": "src",
    "outDir": "lib",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": true,
    "types": ["node"]
  },
  "include": [
    "src/adb.ts",
    "src/android-host.ts",
    "src/app-list.ts",
    "src/build-run.ts",
    "src/debug-parse.ts",
    "src/frame-source.ts",
    "src/index.ts",
    "src/list-rows.ts",
    "src/mcp-schema.ts",
    "src/mcp-tool.ts",
    "src/ocr-backend.ts",
    "src/policy.ts",
    "src/server.ts",
    "src/tool-apps.ts",
    "src/tool-debug.ts",
    "src/tool-list-rows.ts",
    "src/tool-logs.ts",
    "src/tool-ocr.ts",
    "src/tool-support.ts",
    "src/tool-uitree.ts",
    "src/tools.ts",
    "src/uitree.ts",
    "src/vision.ts"
  ]
}
